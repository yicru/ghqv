{
  "name": "ghqv",
  "version": "0.1.0",
  "description": "Virtual monorepo workspace manager for ghq-managed repositories",
  "type": "module",
  "bin": {
    "ghqv": "src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "test:integration": "bun test test/integration",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build": "bun run scripts/build.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/bun": "^1.1.13",
    "@biomejs/biome": "^1.9.4"
  }
}
